# ACP sin escalar: matriz de covarianzas
acp_sin_escalar <- prcomp(
data_sin_dup,
center = TRUE,
scale. = FALSE
)
# ACP normado: matriz de correlaciones
acp_escalado <- prcomp(
data_sin_dup,
center = TRUE,
scale. = TRUE
)
# Varianza explicada por las dos primeras componentes
summary(acp_sin_escalar)$importance[, 1:2]
summary(acp_escalado)$importance[, 1:2]
