d2 = mahalanobis(X,
center=colMeans(X),
cov=cov(X))
outliers_idx = which(d2 > qchisq(0.975, df=ncol(X)))
paste0("Outliers detectados: ", length(outliers_idx),
" -> ", paste(rownames(X)[outliers_idx], collapse=", "))
# Resumen de las distancias de Mahalanobis al cuadrado
summary(d2)
# Umbral utilizado
umbral <- qchisq(0.975, df = ncol(X))
cat("Umbral:", umbral, "\n")
# Proporción de observaciones detectadas
cat("Total de observaciones:", nrow(X), "\n")
cat("Posibles outliers:", sum(d2 > umbral), "\n")
cat("Porcentaje:", round(mean(d2 > umbral) * 100, 2), "%\n")
# Mostrar las 15 observaciones con mayor distancia
orden <- order(d2, decreasing = TRUE)
data.frame(
Pais = rownames(X)[orden[1:min(15, nrow(X))]],
Distancia_Mahalanobis2 = d2[orden[1:min(15, nrow(X))]
)
# Resumen de las distancias de Mahalanobis al cuadrado
summary(d2)
# Umbral utilizado
umbral <- qchisq(0.975, df = ncol(X))
cat("Umbral:", umbral, "\n")
# Proporción de observaciones detectadas
cat("Total de observaciones:", nrow(X), "\n")
cat("Posibles outliers:", sum(d2 > umbral), "\n")
cat("Porcentaje:", round(mean(d2 > umbral) * 100, 2), "%\n")
# Mostrar las 15 observaciones con mayor distancia
orden <- order(d2, decreasing = TRUE)
n_mostrar <- min(15, nrow(X))
indices <- orden[seq_len(n_mostrar)]
resultado <- data.frame(
Pais = rownames(X)[indices],
Distancia_Mahalanobis2 = d2[indices]
)
print(resultado)
)
