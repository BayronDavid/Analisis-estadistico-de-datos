# Crear una función para crear boxplot
boxplot_estadisticos <- function(data2, variable, titulo, subtitulo, etiqueta_x) {
valores <- data2[[variable]]
estadisticos <- boxplot.stats(valores)$stats
etiquetas <- data.frame(
x = as.numeric(estadisticos),
y = c(1.20, 1.30, 1.40, 1.50, 1.60),
etiqueta = c(
paste0("Bigote inf.: ", round(estadisticos[1], 1)),
paste0("Q1: ", round(estadisticos[2], 1)),
paste0("Q2: ", round(estadisticos[3], 1)),
paste0("Q3: ", round(estadisticos[4], 1)),
paste0("Bigote sup.: ", round(estadisticos[5], 1))))
ggplot(data2, aes(x = .data[[variable]], y = 1)) +
geom_boxplot(
fill = rojo,
color = rojo_oscuro,
width = 0.35) +
geom_segment(
data = etiquetas,
aes(
x = x,
xend = x,
y = 0.82,
yend = y
),
color = rojo_oscuro,
linewidth = 0.5,
linetype = "dashed") +
geom_text(
data = etiquetas,
aes(
x = x,
y = y,
label = etiqueta
),
hjust = -0.05,
size = 3.5,
fontface = "bold",
color = "#950606") +
labs(
title = titulo,
subtitle = subtitulo,
x = etiqueta_x,
y = NULL) +
theme_minimal() +
theme(
plot.title = element_text(
face = "bold",
size = 14,
hjust = 0.5),
plot.subtitle = element_text(
size = 11,
hjust = 0.5),
axis.text.y = element_blank(),
axis.ticks.y = element_blank(),
axis.title.y = element_blank(),
axis.title.x = element_text(face = "bold"),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank())}
boxplot_estadisticos(
datos2,
"T1",
"Distribución Consumo(C)",
"Paises",
"Electricidad consumidad(BKWH)")
# Colores usados en todos los gráficos del taller
rojo        <- "#DA0921"
rojo_oscuro <- "#950606"
boxplot_estadisticos(
datos2,
"T1",
"Distribución Consumo(C)",
"Paises",
"Electricidad consumidad(BKWH)")
boxplot_estadisticos(
datos2,
"T1",
"Distribución Turbina 1",
"Producción mensual",
"Megavatio-hora(MWh)")
boxplot_estadisticos(
datos2,
"T2",
"Distribución Turbina 2",
"Producción mensual",
"Megavatio-hora(MWh)")
boxplot_estadisticos(
datos2,
"T3",
"Distribución Turbina 3",
"Producción mensual",
"Megavatio-hora(MWh)")
boxplot_estadisticos(
datos2,
"T4",
"Distribución Turbina 4",
"Producción mensual",
"Megavatio-hora(MWh)")
boxplot_estadisticos(
datos2,
"T5",
"Distribución Turbina 5",
"Producción mensual",
"Megavatio-hora(MWh)")
